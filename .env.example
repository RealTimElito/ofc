# App
OFC_DATA_DIR=./data
OFC_SECRET_KEY=change-me-to-a-long-random-string
OFC_FERNET_KEY=

# LLM (OpenAI-compatible — Ollama, vLLM, LM Studio, internal gateway)
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1
LLM_TIMEOUT_SECONDS=300
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3

# Optional: default system prompt override
# LLM_SYSTEM_PROMPT=

# Server
OFC_HOST=0.0.0.0
OFC_PORT=8000
OFC_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
